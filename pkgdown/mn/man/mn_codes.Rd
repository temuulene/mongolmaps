% source: man/mn_codes.Rd md5 161ab473d09fbfe7c51c71484afd8fb0
\title{Монголын засаг захиргааны нэгжийн код ба нэр}
\description{
Багцын бүх газрын зургийн цаад хүснэгтийг буцаана: улсаас баг, хороо хүртэлх
нэгж бүрт нэг мөр, код, нэр, шатлал дахь байршилтай. Кодыг хайх, өөрийн
холболтын хүснэгт үүсгэх, аль нэгж хилтэйг харахад ашиглана.
}
\arguments{
\item{level}{Буцаах түвшин (\code{\link[=mn_match]{mn_match()}}-ийг үзнэ үү); \code{NULL} бол бүгдийг.}

\item{within}{Зөвхөн энэ дээд нэгж доторх нэгжийг үлдээнэ (нэр эсвэл код).}

\item{aliases}{\code{TRUE} бол нэгж бүрт нэг мөрийн оронд нэгж бүрийн мэдэгдэж
буй бичлэг бүрт нэг мөр (\code{\link[=mn_match]{mn_match()}}-ийн ашигладаг хүснэгт) буцаана.}

\item{lang}{\code{name} баганын хэл: \code{"en"} (англи, ҮСХ-ны хүснэгтийн
бичлэгээр), \code{"mn"} (кирил) эсвэл \code{"mns"} (тэмдэгттэй латин). Анхдагч
утга нь \code{getOption("mongolmaps.lang", "en")}.}
}
\value{
Tibble. \code{aliases = FALSE} бол засаг захиргааны газрын зургийн бүх багана
(\code{\link[=mn_admin]{mn_admin()}}-ийг үзнэ үү) ба \code{has_geometry}. \code{aliases = TRUE} бол
\code{pcode}, \code{level}, \code{name_en}, \code{alias}, \code{source}.
}
\details{
Нэгжийг бүх түвшинд давтагдашгүй \code{pcode}-оор ялгана:
\itemize{
\item улсад \code{"MN"}, эдийн засгийн бүсэд \code{"MNR1"}-ээс \code{"MNR5"} хүртэл
(Баруун, Хангай, Төв, Зүүн, Улаанбаатар);
\item аймагт \code{"MN"} + ҮСХ-ны хоёр оронтой аймгийн код (\code{"MN84"} Ховд,
\code{"MN11"} Улаанбаатар);
\item сум, Улаанбаатарын дүүрэгт дахин хоёр орон (\code{"MN8401"}), баг,
хороонд дахин хоёр орон (\code{"MN110751"}).
}

Эдгээр нь хүмүүнлэгийн Common Operational Dataset-ийн P-кодтой ижил бөгөөд
ҮСХ-ны статистикийн кодоос эхний бүсийн цифрийг хассантай тэнцүү
(\code{nso_code}, ҮСХ-ны PXWeb хүснэгтэд хэрэглэдэг).

\code{type} багана нэг түвшний нэгжүүдийг ялгана: аймгийн дунд \code{"capital"}
(Улаанбаатар); сумын дунд \code{"district"} ба \code{"village"}; багийн дунд
\code{"khoroo"}. Тосгон, хөдөөгийн баг код, статистиктай ч хилгүй
(\code{has_geometry} нь \code{FALSE}).
}
