% source: man/mn_join.Rd md5 7608f2a791370cbce9d6ed752128eaa1
\title{Өөрийн өгөгдлийг Монголын газрын зурагтай холбох}
\description{
Хүснэгтийг хил хязгаартай нэг алхамд холбоно. \code{by} баганад дурын түгээмэл
бичлэгийн нэр, кирил нэр, ҮСХ-ны код, ISO код эсвэл P-код байж болно;
тэдгээрийг \code{\link[=mn_match]{mn_match()}}-ээр тааруулна. Тухайн түвшний бүх нэгж үлддэг
тул өгөгдөлгүй газар ч газрын зураг дээр (\code{NA}-тай) харагдана.
}
\arguments{
\item{data}{Хүснэгт (data frame).}

\item{by}{\code{data} дахь газрын нэр эсвэл кодын багана, тэмдэгт мөр эсвэл
хашилтгүй баганын нэрээр.}

\item{level}{\code{by} дахь газруудын түвшин. \code{NULL} бол автоматаар тодорхойлно.}

\item{by_parent}{Мөр бүрийн дээд нэгжийг (жишээ нь сум бүрийн аймгийг)
заах \code{data} дахь нэмэлт багана. Сум эсвэл багийн нэр улс даяар давхардах
үед хэрэгтэй.}

\item{within}{Зөвхөн эдгээр газар доторх нэгжүүд, эсвэл эдгээр газрыг өөрсдийг
нь үлдээнэ: дурын түвшний нэр эсвэл код, жишээ нь \code{"Ховд"}, \code{"MN84"},
\code{"Баруун бүс"}.}

\item{drop_other_levels}{\code{TRUE} (анхдагч) бол бусад түвшний нэгжийн мөрийг,
жишээ нь сумын хүснэгт дэх улсын болон аймгийн дүнг, нэг мэдэгдэлтэйгээр
хасна. \code{FALSE} бол тэдгээрийг тохироогүй гэж мэдээлнэ.}

\item{resolution}{\code{"low"} (анхдагч) нь багцтай хамт ирдэг, ихэнх газрын
зурагт тохирох хялбаршуулсан хилийг ашиглана. \code{"high"} нь бүрэн
нарийвчлалтай хилийг нэг удаа (ойролцоогоор 10 МБ) татаж, хадгална;
\code{\link[=mn_cache_dir]{mn_cache_dir()}}-ийг үзнэ үү.}

\item{lang}{\code{name} баганын хэл: \code{"en"} (англи, ҮСХ-ны хүснэгтийн
бичлэгээр), \code{"mn"} (кирил) эсвэл \code{"mns"} (MNS 5217 стандартын
латин, тэмдэгттэй). Анхдагч утга нь \code{getOption("mongolmaps.lang", "en")}.}

\item{crs}{Үр дүнгийн координатын систем. \code{NULL} (анхдагч) бол уртраг,
өргөрөг (EPSG:4326) хэвээр. Монголд тохирсон проекцод \code{"albers"},
\code{"lcc"} эсвэл \code{"utm"}-ийг (\code{\link[=mn_crs]{mn_crs()}}-ийг үзнэ үү), эсвэл
\code{\link[sf:st_crs]{sf::st_crs()}}-ийн хүлээн авах дурын утгыг өгнө.}
\item{fuzzy, max_dist}{\code{mn_match()}-д дамжуулах ойролцоо тааруулалтын тохиргоо.}

\item{strict}{\code{TRUE} бол дутуу, таараагүй, олон боломжтой, ойролцоо таарсан түлхүүр, хилгүй нэгж, давхардсан статистикийн түлхүүр болон нийслэлийн зөрүүтэй утгад алдаа өгнө.}

\item{strata}{Он, сар, хүйс, үзүүлэлт зэрэг статистикийн бүлэглэх баганын нэрс. \code{NULL} нь түгээмэл нэрсийг танина; бусад хэмжээсийг тодорхой өгнө.}

\item{value_cols}{Улаанбаатарын утгыг нөхөх хэмжигдэхүүний баганууд. \code{NULL} нь түлхүүрээс бусад тоон багануудыг авна.}

\item{ub_policy}{\code{"prefer_city"} нь нийслэлийн дутуу утгыг бүсээс нөхнө; \code{"prefer_region"} нь эсрэг дараалалтай; \code{"error"} нь зөрүүтэй утгад зогсоно; \code{"none"} нь нөхөлтийг идэвхгүй болгоно.}

\item{duplicates}{Нэг газар, статистикийн бүлэгт давхардсан түлхүүрийг \code{"allow"}, \code{"warn"}, \code{"error"} горимоор хянана.}
}
\value{
Бүх зорилтот нэгжийг агуулсан \code{sf} хүснэгт. Давхардсан баганын нэрд \code{.data} залгана. \code{mn_join_audit()} нь анхны оролтын мөр бүрийн тайланг буцаана.
}
\details{
\strong{Түвшин ба газарзүйн хүрээ.} \code{within} нь нэр тааруулах боломжит нэгжийг хязгаарлана. \code{by_parent} нь мөр бүрийн эцэг нэгжийг заана. Бусад түвшний нийлбэр мөрийг тусад нь мэдээлнэ.

\strong{Улаанбаатар.} ҮСХ-ны 5 болон 511 код тухайн хүснэгтэд нийслэлийн ижил статистикийг илэрхийлж байгааг мета өгөгдлөөс нягтална. Утгыг нийт хүснэгтээр бус, \code{strata}-д өгсөн он, сар, хүйс зэрэг бүлэг тус бүрд нөхнө. Хоёр кодын дутуу бус утга зөрвөл анхааруулга өгнө. Хэмжээс бүрийг тодорхой зааж, буруу утгаар хэрэглэсэн кодыг автоматаар нэгтгэхгүй байх шаардлагатай.

\strong{Шалгалтын мөр.} \code{mn_join_audit()} нь оролтын анхны мөр бүрийн үр дүнг хадгална: нэгтгэсэн, нөхсөн, орлуулсан, хүрээнээс гадуур, өөр түвшин, таараагүй эсвэл хилгүй. Мөрийн дугаар нь анхны хүснэгтэд хамаарна. Холимог түвшний нийлбэр болон бүрэлдэхүүн хэсгийг давхар тоолж, нийт хадгалсан хувийг тооцож болохгүй.

Нэг газар олон он, үзүүлэлттэй байж болно; тэдгээрийг статистикийн түлхүүрт оруулна. Хилгүй баг, тосгоныг тусад нь мэдээлж хасна.
}
