% source: man/mn_join_audit.Rd md5 3b40f3890a13c185676b7ffb0abb3c1c
\title{Газрын зурагтай нэгтгэсэн мөр бүрийн шийдвэрийг шалгах}
\description{\code{mn_join()}-ийн анхны оролтын мөр бүрийн тааруулалт, нөхөлт болон хасагдсан шалтгааныг харуулна.}
\arguments{
\item{x}{\code{mn_join()}-ээс буцсан объект.}
}
\value{Анхны мөрийн дугаар, оролтын утга, хэвийн түлхүүр, эцэг код, таарсан код, арга, засварын зай, боломжит нэгж болон \code{action}-ыг агуулсан tibble.}
\details{\code{action} нь нэгтгэсэн, нөхсөн, орлуулсан, хүрээнээс гадуур, өөр түвшин, дутуу, таараагүй, олон боломжтой, хилгүй мөрийг ялгана. Мөрийн дугаар нь анхны хүснэгтэд хамаарна. Объектыг дахин бүтээхэд атрибут алдагдаж болно.}
